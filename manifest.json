{
  "manifest_version": 3,
  "name": "Pisces (AI Detector)",
  "version": "1.0",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "components/background.js"
  },
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://mail.yahoo.com/*",
    "https://mail.icloud.com/*",
    "https://mail.proton.me/*",
    "https://app.proton.me/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://mail.yahoo.com/*",
        "https://mail.icloud.com/*",
        "https://mail.proton.me/*",
        "https://app.proton.me/*"
      ],
      "js": ["components/content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "components/popup.html",
    "default_icon": {
      "128": "components/images/icon-default.png"
    }
  }
}