{
  "manifest_version": 3,
  "name": "Pisces (AI Detector)",
  "version": "1.0",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "frontend/background.js"
  },
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://mail.yahoo.com/*",
    "https://mail.icloud.com/*",
    "https://mail.proton.me/*",
    "https://app.proton.me/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://mail.yahoo.com/*",
        "https://mail.icloud.com/*",
        "https://mail.proton.me/*",
        "https://app.proton.me/*"
      ],
      "js": ["frontend/content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "frontend/popup.html"
  }
}